# Copy to .env and fill in. Never commit real keys.
MISTRAL_API_KEY=            # used for Pixtral caption + facet extraction (optional; falls back to local BLIP)
OPENINTEREST_AGENT_KEY=     # API key for the agent/delegation endpoints
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
OPENINTEREST_DB=data/openinterest.db
OPENCLIP_MODEL=ViT-B-32
OPENCLIP_PRETRAINED=laion2b_s34b_b79k
DINOV2_MODEL=vitb14
ENABLE_OBJECT_EMBEDDINGS=0   # sam-clip; slow on CPU
